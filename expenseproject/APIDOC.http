#----------------EXPENCE VIEWS-----------

# API call for create expence

###
POST http://127.0.0.1:8000/expense
Content-Type: application/json
Authorization: Basic alan:password@123

{
    "title":"trip",
    "amount":"2000",
    "category":"bill",
    "payment":"UPI"
}

# API call for list the expences

###
GET http://127.0.0.1:8000/expense
Authorization: Basic akshay:password@123



# API call for list user expences
###
GET http://127.0.0.1:8000/expense/1
Authorization: Basic akshay:password@123

# API call for updating expence

###
PATCH http://127.0.0.1:8000/expense/4
Content-Type: application/json
Authorization: Basic akshay:password@123

{
  "id": 1,
  "title": "gym",
  "amount": "700.00",
  "created_at": "2026-10-22T14:08:27.230546Z",
  "category": "bill",
  "payment": "Card",
  "owner": 1
}

# API call for delete expence

###
###
DELETE http://127.0.0.1:8000/expense/1
Authorization: Basic akshay:password@123


# API call for filter based catagory and payment

###
GET http://127.0.0.1:8000/expense?payment=Card
Authorization: Basic akshay:password@123


# API call for search expense title

###
GET http://127.0.0.1:8000/expense?search=trip
Authorization: Basic alan:password@123


# API call for order based on created date

###
GET http://127.0.0.1:8000/expense?ordering=amount
Authorization: Basic akshay:password@123